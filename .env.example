# Host port exposed by Docker Compose
APP_PORT=12000
UPLOADS_DIR=/app/public/uploads
BACKUPS_DIR=/app/data/backups
# Optional test override; production leaves this empty and runs nightly at 03:00.
BACKUP_INTERVAL_MS=

# Docker-managed persistent volumes (portable default)
MODELVAULT_DATA_DIR=modelvault_data
MODELVAULT_UPLOADS_DIR=modelvault_uploads

# Host bind-mount alternatives; replace these placeholders with your own paths:
# MODELVAULT_DATA_DIR=/path/to/finddex-data
# MODELVAULT_UPLOADS_DIR=/path/to/finddex-uploads

# UID/GID that owns the two host directories (the node image defaults to 1000:1000)
PUID=1000
PGID=1000

# Relative to prisma/schema.prisma; Docker Compose overrides this inside the container.
DATABASE_URL=file:./dev.db?connection_limit=1&socket_timeout=30

# Optional Telegram bot: docker compose --profile telegram up -d --build
# Full scraper endpoint, for example http://192.168.1.51:8582/scrape
INSTAGRAM_SCRAPER_URL=
# Create a dedicated bot with @BotFather; never share its token.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID. Leave empty to discover it using /whoami (imports disabled).
TELEGRAM_ALLOWED_USER_ID=
# en or tr; English is the default.
TELEGRAM_BOT_LANGUAGE=en
# Create a dedicated key under FindDex Settings > API Access.
FINDDEX_BOT_API_KEY=
# For a worker running without Docker; Compose always uses http://app:3000.
FINDDEX_INTERNAL_URL=http://127.0.0.1:3000
